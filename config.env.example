# Shared settings, sourced by every script. Copy to config.env (git-ignored) and fill in the real values.
PROJECT_ID=my-gcp-project
REGION=us-central1
ZONE=us-central1-a
DR_REGION=us-east1
BQ_LOCATION=US
BUCKET=my-gcp-project-raw
DATASET=ecommerce
DR_DATASET=ecommerce_dr
TOPIC=rees46-events
SUBSCRIPTION=rees46-events-dataflow
VM_NAME=ingest-vm
# One service account per component, least privilege (infra/00_iam.sh)
SA_INGESTA=sa-ingesta@my-gcp-project.iam.gserviceaccount.com
SA_DATAFLOW=sa-dataflow@my-gcp-project.iam.gserviceaccount.com
SA_TRANSFORM=sa-transform@my-gcp-project.iam.gserviceaccount.com

# Fine-grained access (infra/06_acceso_fino.py, sql/15_acceso_filas.sql)
OWNER_ACCOUNT=owner@example.com
TEAM_FULL_ACCESS=teammate@example.com
ANALYST_ACCOUNT=analyst@example.com

# Billing (currency of the billing account). Budget needs the billing admin account.
BILLING_ACCOUNT=000000-000000-000000
BILLING_ADMIN=billing-admin@example.com
BUDGET_PEN=100
ALERT_EMAIL=alertas@example.com

# Dataflow sizing (caps spend)
DF_MAX_WORKERS=3
DF_MACHINE=n1-standard-2

# Safety cap per bq call, a whole multi-statement script counts as one: 100 GB (~0.61 USD at list price)
MAX_BYTES_BILLED=107374182400

KAGGLE_REES46=mkechinov/ecommerce-behavior-data-from-multi-category-store
KAGGLE_OLIST=olistbr/brazilian-ecommerce
